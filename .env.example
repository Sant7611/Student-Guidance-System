# Django
SECRET_KEY=your-very-long-secret-key-change-this-in-production
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost,your-app.onrender.com

# Database (Render provides this automatically)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Redis (Render provides this)
REDIS_URL=redis://host:6379/0

# CORS / CSRF
CSRF_TRUSTED_ORIGINS=http://localhost:5173,https://your-frontend.onrender.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.onrender.com

# Localization
LANGUAGE_CODE=en-us
TIME_ZONE=UTC

# Email (Gmail SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com

CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME